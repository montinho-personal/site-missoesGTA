# URL pública do site (sem barra final). Usada em canonical, sitemap e Open Graph.
# Em produção, sem esta variável, vale https://missoessecretasgta.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de publicação: só com "true" o site libera indexação (robots, meta robots).
# Deixe vazio em previews e enquanto o conteúdo não for revisado.
SITE_INDEXABLE=

# Postgres (Supabase ou outro). Vazio = PGlite local com os dados de content/seed.
DATABASE_URL=

# Painel administrativo. Sem estas duas variáveis o painel fica desativado.
ADMIN_PASSWORD=
SESSION_SECRET=

# Mensuração (carregada somente após consentimento). Vazio = nada é carregado.
NEXT_PUBLIC_GTM_ID=

# Verificação de propriedade (opcional)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Venda do aplicativo pelo Mercado Pago (Checkout Pro). Sem estas três, a venda fica desligada
# e a página /app/ mostra a lista de aviso. Nunca coloque estes valores no repositório.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
APP_PRICE_BRL=
